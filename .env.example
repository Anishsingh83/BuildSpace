# Copy to .env and fill in. Never commit .env.
# Letters and numbers only in POSTGRES_PASSWORD: it is placed inside a URL.
POSTGRES_PASSWORD=CHANGE_ME_LETTERS_AND_NUMBERS_ONLY
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# The public address of the site, exactly as users type it.
SITE_URL=https://your-domain.example
ENVIRONMENT=production
COOKIE_SECURE=true
# For a local test over plain http, use:
#   ENVIRONMENT=development, COOKIE_SECURE=false, SITE_URL=http://localhost:8080